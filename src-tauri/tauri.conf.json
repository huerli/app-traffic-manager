{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Traffic Manager",
  "version": "2.1.0",
  "identifier": "local.flow.traffic-manager",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:17891"
  },
  "app": {
    "windows": [
      {
        "title": "Flow · 应用流量管理",
        "width": 1280,
        "height": 880,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/flow.png",
      "icons/flow.ico",
      "icons/flow.icns"
    ],
    "externalBin": [
      "binaries/flow-backend"
    ]
  }
}
